# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/zenflow

# Security
JWT_SECRET=zenflow_jwt_secret_key_change_me_in_production
JWT_REFRESH_SECRET=zenflow_jwt_refresh_secret_key_change_me_in_production

# SMTP configuration (Optional - fallback to console logger in development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Cloudinary configuration (Optional - fallback to local server disk upload in development)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
